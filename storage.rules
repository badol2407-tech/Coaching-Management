rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        userProfile().role == 'super_admin' &&
        request.auth.token.admin == true;
    }

    function isAuthorizedOrgMember(orgId) {
      return isSignedIn() &&
        userProfile().orgId == orgId &&
        (
          userProfile().role in [
            'org_admin',
            'teacher',
            'student',
            'guardian'
          ] ||
          (
            userProfile().role == 'administrative_staff' &&
            ('permissions' in userProfile()) &&
            userProfile().permissions is list &&
            'organization.read' in userProfile().permissions
          )
        ) &&
        (!('status' in userProfile()) || userProfile().status == 'active');
    }

    function canAccessOrg(orgId) {
      return isSuperAdmin() || isAuthorizedOrgMember(orgId);
    }

    // Student photos uploaded by authenticated org members
    match /organizations/{orgId}/student-photos/{filename} {
      // Only active members of this organization or Super Admin may access photos.
      allow read: if canAccessOrg(orgId);

      // Authenticated users can upload photos up to 10 MB (JPEG/PNG)
      allow write: if canAccessOrg(orgId)
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png)');
    }

    // Profile photos for admin/teacher accounts
    match /profile-photos/{uid}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png)');
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
