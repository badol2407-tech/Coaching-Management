rules_version = '2';

// EduTrack security rules.
//
// Core invariants enforced here:
//  1. Nobody can self-register except the narrow, atomic public org-admin
//     onboarding path below and the one-time super-admin bootstrap.
//  2. Only the Super Admin account can manage existing organizations.
//  3. All org-scoped data is isolated per orgId.
//  4. Seen receipts are limited to the student who owns the receipt.
//  5. Platform-level writes require the super_admin role.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? myProfile().role
        : null;
    }

    function myOrgId() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? myProfile().orgId
        : null;
    }

    function isSuperAdmin() {
      return myRole() == 'super_admin';
    }

    function isOrgAdmin(orgId) {
      return myRole() == 'org_admin' && myOrgId() == orgId;
    }

    function isTeacher(orgId) {
      return myRole() == 'teacher' && myOrgId() == orgId;
    }

    function isStudent(orgId) {
      return myRole() == 'student' && myOrgId() == orgId;
    }

    function isGuardian(orgId) {
      return myRole() == 'guardian' && myOrgId() == orgId;
    }

    function isAdministrativeStaff(orgId) {
      return myRole() == 'administrative_staff' && myOrgId() == orgId;
    }

    function isValidUserRole(role) {
      return role in [
        'super_admin',
        'org_admin',
        'teacher',
        'student',
        'guardian',
        'administrative_staff'
      ];
    }

    function linkedStudentIds() {
      return myProfile().linkedStudentIds is list
        ? myProfile().linkedStudentIds
        : myProfile().studentIds is list
          ? myProfile().studentIds
          : myProfile().childrenIds is list
            ? myProfile().childrenIds
            : myProfile().studentId is string
              ? [myProfile().studentId]
              : [];
    }

    function isLinkedStudent(studentId) {
      return studentId is string && studentId in linkedStudentIds();
    }

    function isLinkedResource(orgId) {
      return isGuardian(orgId) &&
        (
          (resource.data.studentId is string && isLinkedStudent(resource.data.studentId)) ||
          (resource.data.studentIds is list && resource.data.studentIds.hasAny(linkedStudentIds()))
        );
    }

    function isLinkedCreate(orgId) {
      return isGuardian(orgId) &&
        (request.resource.data.studentId is string && isLinkedStudent(request.resource.data.studentId));
    }

    function isOrgStaff(orgId) {
      return isOrgAdmin(orgId) || isTeacher(orgId) || isAdministrativeStaff(orgId);
    }

    function isOrgMember(orgId) {
      return isOrgAdmin(orgId) || isTeacher(orgId) || isStudent(orgId) ||
        isGuardian(orgId) || isAdministrativeStaff(orgId);
    }

    // ── users/{uid} ──────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isSuperAdmin() ||
        isOrgAdmin(resource.data.orgId) ||
        isAdministrativeStaff(resource.data.orgId)
      );

      // Existing bootstrap/admin creation paths plus the public signup path.
      // The public path is constrained to the caller's own UID/email, an
      // org_admin role, a fixed field set, and a matching atomic org write.
      allow create: if (
        isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role == 'super_admin' &&
        request.resource.data.orgId == null
      ) || (
        isSignedIn() &&
        isSuperAdmin() &&
        isValidUserRole(request.resource.data.role)
      ) || (
        isSignedIn() &&
        isOrgAdmin(request.resource.data.orgId) &&
        isValidUserRole(request.resource.data.role)
      ) || (
        isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role == 'org_admin' &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.orgId is string &&
        request.resource.data.createdByPublicSignup == true &&
        request.resource.data.keys().hasOnly([
          'role', 'orgId', 'name', 'email', 'mustChangePassword',
          'createdAt', 'createdByPublicSignup'
        ]) &&
        getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.adminUid == uid &&
        getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.adminEmail == request.auth.token.email &&
        getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.status == 'active'
      );

      // Self-updates remain restricted to non-privileged fields. Admins retain
      // the existing management permissions.
      allow update: if isSignedIn() && (
        (
          request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['mustChangePassword', 'updatedAt'])
        ) ||
        (
          isSuperAdmin() &&
          isValidUserRole(request.resource.data.role)
        ) ||
        (
          isOrgAdmin(resource.data.orgId) &&
          isValidUserRole(request.resource.data.role)
        )
      );
      allow delete: if isSignedIn() && (isSuperAdmin() || isOrgAdmin(resource.data.orgId));
    }

    // ── organizations/{orgId} ────────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if isSuperAdmin() || isOrgMember(orgId);

      // Keep super-admin management, and add only the matching atomic public
      // onboarding write. getAfter() ensures the profile and organization are
      // created together and point at each other.
      allow create: if (
        isSignedIn() && isSuperAdmin()
      ) || (
        isSignedIn() &&
        request.auth.uid == request.resource.data.adminUid &&
        request.resource.data.adminEmail == request.auth.token.email &&
        request.resource.data.name is string &&
        request.resource.data.adminUid is string &&
        request.resource.data.tier in ['free_trial', 'founder_launch', 'annual_premium'] &&
        request.resource.data.plan in ['free', 'basic', 'pro'] &&
        request.resource.data.accountStatus == 'active' &&
        request.resource.data.status == 'active' &&
        request.resource.data.paymentStatus == 'unpaid' &&
        request.resource.data.keys().hasOnly([
          'name', 'adminEmail', 'adminUid', 'createdAt', 'tier', 'plan',
          'subscriptionStartDate', 'subscriptionExpiryDate', 'accountStatus',
          'status', 'paymentStatus'
        ]) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'org_admin' &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdByPublicSignup == true
      );
      allow update, delete: if isSignedIn() && isSuperAdmin();

      // Classes are readable publicly for /join/:code, but writable by staff.
      match /classes/{classId} {
        allow read: if true;
        allow write: if isOrgStaff(orgId) || isSuperAdmin();
      }

      // Public join requests are reviewed by organization staff.
      match /admission_requests/{reqId} {
        allow create: if true;
        allow read, update, delete: if isOrgStaff(orgId) || isSuperAdmin();
      }

      match /teacher_requests/{reqId} {
        allow create: if true;
        allow read, update, delete: if isOrgStaff(orgId) || isSuperAdmin();
      }

      match /students/{studentId} {
        allow read: if isOrgStaff(orgId) || isSuperAdmin() ||
          ((isStudent(orgId) || isGuardian(orgId)) && isLinkedStudent(studentId));
        allow write: if isOrgStaff(orgId) || isSuperAdmin();
      }

      match /teachers/{teacherId} {
        allow read: if isOrgStaff(orgId) || isSuperAdmin();
        allow write: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      match /attendance/{docId} {
        allow read: if isOrgStaff(orgId) || isSuperAdmin() || isStudent(orgId) || isLinkedResource(orgId);
        allow write: if isOrgStaff(orgId) || isSuperAdmin();
      }

      match /fees/{feeId} {
        allow read: if isOrgStaff(orgId) || isSuperAdmin() || isStudent(orgId) || isLinkedResource(orgId);
        allow write: if isOrgStaff(orgId) || isSuperAdmin();

        match /seen/{uid} {
          allow read: if isOrgStaff(orgId) || isSuperAdmin();
          allow write: if isStudent(orgId) && request.auth.uid == uid;
        }
      }

      match /id_cards/{cardId} {
        allow read, write: if isOrgStaff(orgId) || isSuperAdmin();
      }

      match /certificates/{certificateId} {
        allow read, write: if isOrgStaff(orgId) || isSuperAdmin();
      }

      match /results/{resultId} {
        allow read: if isOrgStaff(orgId) || isSuperAdmin() || isStudent(orgId) || isLinkedResource(orgId);
        allow write: if isOrgStaff(orgId) || isSuperAdmin();
      }

      match /routine/{slotId} {
        allow read: if isOrgStaff(orgId) || isSuperAdmin() || isStudent(orgId) || isLinkedResource(orgId);
        allow write: if isOrgStaff(orgId) || isSuperAdmin();

        match /seen/{uid} {
          allow read: if isOrgStaff(orgId) || isSuperAdmin();
          allow write: if isStudent(orgId) && request.auth.uid == uid;
        }
      }

      match /homework/{hwId} {
        allow read: if isOrgStaff(orgId) || isSuperAdmin() || isStudent(orgId) || isLinkedResource(orgId);
        allow write: if isOrgStaff(orgId) || isSuperAdmin();

        match /seen/{uid} {
          allow read: if isOrgStaff(orgId) || isSuperAdmin();
          allow write: if isStudent(orgId) && request.auth.uid == uid;
        }
      }

      match /notices/{noticeId} {
        allow read: if isOrgStaff(orgId) || isSuperAdmin() || isStudent(orgId) || isLinkedResource(orgId);
        allow write: if isOrgStaff(orgId) || isSuperAdmin();

        match /seen/{uid} {
          allow read: if isOrgStaff(orgId) || isSuperAdmin();
          allow write: if isStudent(orgId) && request.auth.uid == uid;
        }
      }

      match /exams/{examId} {
        allow read: if isOrgStaff(orgId) || isSuperAdmin() || isStudent(orgId) || isLinkedResource(orgId);
        allow write: if isOrgStaff(orgId) || isSuperAdmin();

        match /seen/{uid} {
          allow read: if isOrgStaff(orgId) || isSuperAdmin();
          allow write: if isStudent(orgId) && request.auth.uid == uid;
        }
      }

      match /expenses/{expId} {
        allow read, write: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      match /guardian_conversations/{conversationId} {
        allow read: if isOrgStaff(orgId) || isSuperAdmin() ||
          (isGuardian(orgId) && resource.data.guardianUid == request.auth.uid &&
            isLinkedStudent(resource.data.studentId));
        allow create: if isGuardian(orgId) &&
          request.resource.data.guardianUid == request.auth.uid &&
          isLinkedStudent(request.resource.data.studentId);
        allow update: if isOrgStaff(orgId) ||
          (isGuardian(orgId) && resource.data.guardianUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessage', 'lastMessageAt', 'updatedAt'
            ]));
        allow delete: if isOrgStaff(orgId) || isSuperAdmin();

        match /messages/{messageId} {
          allow read: if isOrgStaff(orgId) || isSuperAdmin() ||
            (isGuardian(orgId) &&
              get(/databases/$(database)/documents/organizations/$(orgId)/guardian_conversations/$(conversationId)).data.guardianUid == request.auth.uid);
          allow create: if isOrgStaff(orgId) || isSuperAdmin() ||
            (isGuardian(orgId) &&
              getAfter(/databases/$(database)/documents/organizations/$(orgId)/guardian_conversations/$(conversationId)).data.guardianUid == request.auth.uid &&
              request.resource.data.senderUid == request.auth.uid &&
              request.resource.data.senderRole == 'guardian');
          allow update, delete: if false;
        }
      }

      match /leave_requests/{requestId} {
        allow read: if isOrgStaff(orgId) || isSuperAdmin() ||
          (isGuardian(orgId) && resource.data.guardianUid == request.auth.uid &&
            isLinkedStudent(resource.data.studentId));
        allow create: if isGuardian(orgId) &&
          request.resource.data.guardianUid == request.auth.uid &&
          isLinkedStudent(request.resource.data.studentId) &&
          request.resource.data.status == 'pending';
        allow update: if isOrgStaff(orgId) || isSuperAdmin();
        allow delete: if isOrgStaff(orgId) || isSuperAdmin();
      }

      match /notifications/{notificationId} {
        allow read: if isOrgStaff(orgId) || isSuperAdmin() ||
          (isGuardian(orgId) && resource.data.recipientUid == request.auth.uid &&
            isLinkedStudent(resource.data.studentId));
        allow create: if isOrgStaff(orgId) || isSuperAdmin();
        allow update: if isOrgStaff(orgId) || isSuperAdmin() ||
          (isGuardian(orgId) && resource.data.recipientUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']));
        allow delete: if isOrgStaff(orgId) || isSuperAdmin();
      }
    }

    // ── Platform-level Super Admin collections ───────────────────────────────
    match /super_admin_logs/{docId} {
      allow read, write: if isSignedIn() && isSuperAdmin();
    }

    match /platform_payments/{docId} {
      allow read, write: if isSignedIn() && isSuperAdmin();
    }

    match /coupon_codes/{docId} {
      allow read, write: if isSignedIn() && isSuperAdmin();
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isSignedIn() && isSuperAdmin();
    }

    match /popup_offers/{docId} {
      allow read: if true;
      allow write: if isSignedIn() && isSuperAdmin();
    }

    match /platform_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSuperAdmin();
    }

    match /landing_page_layouts/{docId} {
      allow read: if true;
      allow write: if isSignedIn() && isSuperAdmin();
    }

    // ── demo_leads ──────────────────────────────────────────────────────────
    // Public visitors may submit only a new, fixed-shape demo request. Lead
    // details are private and can only be viewed or managed by Super Admin.
    match /demo_leads/{leadId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'fullName', 'phone', 'institute', 'studentCount',
          'source', 'status', 'createdAt'
        ]) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 120 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 7 &&
        request.resource.data.phone.size() <= 30 &&
        request.resource.data.institute is string &&
        request.resource.data.institute.size() >= 2 &&
        request.resource.data.institute.size() <= 160 &&
        request.resource.data.studentCount in ['1-100', '101-300', '301-1000', '1000+'] &&
        request.resource.data.source is string &&
        request.resource.data.source.size() <= 80 &&
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt == request.time;

      allow read: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']) &&
        request.resource.data.status in ['new', 'contacted', 'qualified', 'closed'];
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    match /super_admin_impersonation/{sessionId} {
      allow read, write: if isSignedIn() && isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}