rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isOrgAdmin(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'org_admin';
    }

    // Public onboarding is deliberately narrow: the newly authenticated user
    // may create only their own org-admin profile and its matching organization.
    // getAfter() supports the atomic client batch used by the signup flow.
    match /organizations/{orgId} {
      allow create: if signedIn()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.adminEmail == request.auth.token.email
        && request.resource.data.status == 'active'
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.tier in ['free_trial', 'founder_launch', 'annual_premium']
        && request.resource.data.keys().hasOnly([
          'name', 'adminEmail', 'adminUid', 'createdAt', 'tier', 'plan',
          'subscriptionStartDate', 'subscriptionExpiryDate', 'accountStatus',
          'status', 'paymentStatus'
        ])
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'org_admin'
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId;

      allow read, update, delete: if isSuperAdmin() || isOrgAdmin(orgId);

      match /{subcollection}/{documentId} {
        allow read, write: if isSuperAdmin() || isOrgAdmin(orgId);
      }
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'org_admin'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.orgId is string
        && request.resource.data.createdByPublicSignup == true
        && request.resource.data.keys().hasOnly([
          'role', 'orgId', 'name', 'email', 'mustChangePassword',
          'createdAt', 'createdByPublicSignup'
        ])
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.adminUid == userId;

      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow update: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Marketing content used by the unauthenticated landing experience.
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /popup_offers/{offerId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}